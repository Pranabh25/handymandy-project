# Copy to .env and adjust.
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lushaura?schema=public"
# Used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"
# Public base URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Where admin-uploaded product images are stored on disk
UPLOAD_DIR="./uploads"
